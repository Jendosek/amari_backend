# App
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Postgres used by docker-compose
POSTGRES_USER=amari
POSTGRES_PASSWORD=amari_password
POSTGRES_DB=amari
POSTGRES_PORT=5432

# Prisma connection string
DATABASE_URL=postgresql://amari:amari_password@localhost:5432/amari?schema=public

# JWT
# Generate a secret: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Amari <no-reply@amari.shop>"